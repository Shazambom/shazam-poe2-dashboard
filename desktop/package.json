{
  "name": "poe2-dashboard-desktop",
  "productName": "Arbiter",
  "version": "0.2.61",
  "description": "Exchange-loop dashboard for Path of Exile 2 — desktop app",
  "main": "src/main.js",
  "author": "Shazambom",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "build:frontend": "cd ../frontend && npm run build && rm -rf ../desktop/app-dist && cp -R dist ../desktop/app-dist",
    "build:backend": "./build-backend.sh",
    "build:sidecar": "./build-sidecar.sh",
    "dist:mac": "npm run build:frontend && electron-builder --mac",
    "dist:win": "npm run build:frontend && electron-builder --win",
    "dist:mac:all": "npm run build:backend && npm run build:sidecar && npm run dist:mac",
    "publish": "./publish-github.sh"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.12"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "uiohook-napi": "^1.5.4",
    "ws": "^8.21.3"
  },
  "build": {
    "appId": "com.shazambom.poe2dashboard",
    "productName": "Arbiter",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "app-dist/**/*"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/uiohook-napi/**",
      "src/ee2-history/**",
      "src/vendor/ee2-query/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Shazambom",
        "repo": "shazam-poe2-dashboard"
      }
    ],
    "mac": {
      "target": [
        "zip",
        "dmg"
      ],
      "category": "public.app-category.games",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "backend-bin",
        "to": "backend-bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "market-seed",
        "to": "market-seed",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "sidecar-bin",
        "to": "sidecar-bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "npmRebuild": false
  }
}
