{
  "name": "poe2-dashboard-desktop",
  "productName": "Arbiter",
  "version": "0.3.18",
  "description": "Exchange-loop dashboard for Path of Exile 2 — desktop app",
  "main": "src/main.js",
  "author": "Shazambom",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "build:frontend": "cd ../frontend && npm run build && rm -rf ../desktop/app-dist && cp -R dist ../desktop/app-dist",
    "build:backend": "./build-backend.sh",
    "build:sidecar": "./build-sidecar.sh",
    "dist:mac": "npm run build:frontend && electron-builder --mac",
    "dist:win": "npm run build:frontend && electron-builder --win",
    "dist:mac:all": "npm run build:backend && npm run dist:mac",
    "smoke:mac": "node scripts/smoke-packaged.mjs",
    "profile": "node ../ops/profile.mjs",
    "profile:quick": "node ../ops/profile.mjs --quick",
    "publish": "./publish-github.sh"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "uiohook-napi": "^1.5.4",
    "ws": "^8.23.0"
  },
  "overrides": {
    "minimatch@^9.0.0": "^11.0.1",
    "minimatch@^10.0.0": "^11.0.1"
  },
  "build": {
    "appId": "com.shazambom.poe2dashboard",
    "productName": "Arbiter",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "app-dist/**/*",
      "!node_modules/uiohook-napi/libuiohook/**",
      "!node_modules/uiohook-napi/src/**",
      "!node_modules/uiohook-napi/build/**",
      "!node_modules/uiohook-napi/binding.gyp"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/uiohook-napi/**",
      "src/ee2-history/**",
      "src/vendor/ee2-query/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Shazambom",
        "repo": "shazam-poe2-dashboard"
      }
    ],
    "mac": {
      "target": [
        "zip",
        "dmg"
      ],
      "category": "public.app-category.games",
      "identity": "-"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "backend-bin",
        "to": "backend-bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "market-seed",
        "to": "market-seed",
        "filter": [
          "**/*"
        ]
      }
    ],
    "npmRebuild": false
  }
}
