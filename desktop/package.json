{
  "name": "poe2-dashboard-desktop",
  "productName": "Arbiter",
  "version": "0.2.28",
  "description": "Exchange-loop dashboard for Path of Exile 2 \u2014 desktop app",
  "main": "src/main.js",
  "author": "Shazambom",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:frontend": "cd ../frontend && npm run build && rm -rf ../desktop/app-dist && cp -R dist ../desktop/app-dist",
    "dist:mac": "npm run build:frontend && electron-builder --mac",
    "dist:win": "npm run build:frontend && electron-builder --win",
    "publish": "./publish.sh"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "uiohook-napi": "^1.5.4"
  },
  "build": {
    "appId": "com.shazambom.poe2dashboard",
    "productName": "Arbiter",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "app-dist/**/*"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/uiohook-napi/**"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "http://192.168.1.250:8080/downloads"
      }
    ],
    "mac": {
      "target": [
        "zip",
        "dmg"
      ],
      "category": "public.app-category.games",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "extraResources": [
      {
        "from": "backend-bin",
        "to": "backend-bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "npmRebuild": false
  }
}
