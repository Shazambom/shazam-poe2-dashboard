# Copy to .env and fill in.

# Exact league name as the trade site spells it, e.g. "Standard" or the current challenge league.
LEAGUE=Standard

# Trade session: do NOT put POESESSID here. Connect it from Settings in the dashboard
# (or run tools/connect.py on your gaming PC); it's stored encrypted under ./data.

# OAuth (optional, for account features). Register a client with GGG first — see README.
# Public client: leave OAUTH_CLIENT_SECRET empty; redirect must be http://127.0.0.1:<port>/callback.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://127.0.0.1:8080/callback
OAUTH_SCOPES=account:profile account:characters
OAUTH_CONTACT=you@example.com

# Identify your client to GGG. Include a contact.
USER_AGENT=poe2-arb-dashboard/0.1 (self-hosted; contact: you@example.com)

# Hourly digest: hours of history to backfill on first start, and poll interval.
DIGEST_BACKFILL_HOURS=168
DIGEST_POLL_SECONDS=300

# Live order book: seconds between full watchlist sweeps (per-request pacing follows GGG's
# rate-limit headers automatically).
ORDERBOOK_SWEEP_SECONDS=600

# Port the dashboard is served on.
DASHBOARD_PORT=8080
