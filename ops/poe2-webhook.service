# ShazamDash GitHub release-webhook receiver (DORMANT until go-live).
# Install on shazam:  sudo cp ops/poe2-webhook.service /etc/systemd/system/
#                     sudo systemctl daemon-reload && sudo systemctl enable --now poe2-webhook
# Requires a secret at /home/shazam/.poe2-webhook-secret (chmod 600) matching the
# secret configured in the GitHub repo webhook. See CLAUDE.md → "Go-live: switch to webhook".
[Unit]
Description=ShazamDash GitHub release webhook receiver
After=network.target

[Service]
User=shazam
Environment=WEBHOOK_PORT=9099
Environment=PUBLISH_SCRIPT=/home/shazam/bin/poe2-publish-latest.sh
ExecStart=/usr/bin/python3 /home/shazam/bin/webhook-receiver.py
Restart=on-failure

[Install]
WantedBy=multi-user.target
