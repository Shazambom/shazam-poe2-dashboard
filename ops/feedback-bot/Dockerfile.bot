# The trusted half: holds the bot token + the owner's private key, talks to Discord, decrypts
# (pure math), and never parses a report. Non-root.
FROM python:3.12-slim
RUN useradd -r -u 10001 bot
WORKDIR /app
# The shared spool (a named volume seeded from the image's ownership) must be writable by uid 10001.
RUN mkdir -p /spool/in /spool/out && chown -R 10001 /spool
COPY requirements-bot.txt .
RUN pip install --no-cache-dir -r requirements-bot.txt
COPY bot/ ./bot/
COPY opener/dests.py ./opener/dests.py
COPY opener/__init__.py ./opener/__init__.py
ENV PYTHONPATH=/app:/app/bot PYTHONUNBUFFERED=1
USER bot
CMD ["python", "-m", "bot.bot"]
