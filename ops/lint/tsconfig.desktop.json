{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "es2024",
    "lib": [
      "es2024",
      "dom"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [
      "node"
    ],
    "typeRoots": [
      "./node_modules/@types"
    ],
    "skipLibCheck": true
  },
  "include": [
    "../../desktop/src/**/*.js",
    "../../desktop/scripts/**/*.mjs",
    "../../desktop/test/**/*.mjs"
  ]
}
